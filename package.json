{
  "name": "panjab-117",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "npm run build && npm run verify:static",
    "start": "node scripts/serve-static.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "verify:static": "node scripts/verify-static-export.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:security:intake": "vitest run src/lib/survey/secure-intake.test.ts src/lib/survey/withdrawal-service.test.ts src/lib/survey/mysql-migration.test.ts src/lib/survey/launch-authorization.test.ts src/lib/survey/intake-http-service.test.ts src/lib/survey/screening-retention.test.ts src/lib/survey/step5c-end-to-end.test.ts",
    "test:step5c": "vitest run src/lib/survey/launch-authorization.test.ts src/lib/survey/intake-http-service.test.ts src/lib/survey/screening-retention.test.ts src/lib/survey/step5c-end-to-end.test.ts",
    "test:security:mysql": "vitest run src/lib/security/mysql.integration.test.ts src/lib/security/step5b-mysql.integration.test.ts --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "mysql2": "3.24.6",
    "postcss": "^8.5.0",
    "prettier": "^3.6.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
