# Public canonical URL used for metadata in a later deployment phase.
# Do not place secrets in NEXT_PUBLIC_* variables.
# For Cloudflare Pages, replace this only after the pages.dev name is confirmed
# and deployment is separately approved.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Safe default: search engines are blocked until the public-preview launch is
# separately approved and NEXT_PUBLIC_SITE_URL is the verified HTTPS origin.
PUBLIC_PREVIEW_INDEXING_ENABLED=false

# Fail-closed documentation defaults. Environment flags alone cannot authorize
# a launch; signed, release-bound approval evidence is also required.
LIVE_SURVEY_COLLECTION_ENABLED=false
AI_PROVIDER_ENABLED=false
